@model FullBike.Models.Descuento
@{
    ViewBag.Title = "Nuevo Descuento";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="container">
    <div class="page-header">
        <h1><i class="fas fa-plus-circle"></i> Nuevo Descuento</h1>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Volver</a>
    </div>
    <div class="card">
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Nombre *</label>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Tipo *</label>
                            @Html.DropDownListFor(m => m.TipoDescuento, new SelectList(new[] { "Porcentaje", "MontoFijo" }), new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TipoDescuento, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Valor *</label>
                            @Html.TextBoxFor(m => m.Valor, new { @class = "form-control", type = "number", step = "0.01" })
                            @Html.ValidationMessageFor(m => m.Valor, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Monto mínimo (opcional)</label>
                            @Html.TextBoxFor(m => m.MontoMinimo, new { @class = "form-control", type = "number", step = "0.01" })
                            @Html.ValidationMessageFor(m => m.MontoMinimo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Fecha inicio *</label>
                            @Html.TextBoxFor(m => m.FechaInicio, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.FechaInicio, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Fecha fin (opcional)</label>
                            @Html.TextBoxFor(m => m.FechaFin, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.FechaFin, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Descripción</label>
                    @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = "3" })
                    @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
                </div>
                <div class="form-group form-check">
                    @Html.CheckBoxFor(m => m.Activo, new { @class = "form-check-input" })
                    <label class="form-check-label">Activo</label>
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar</button>
            </form>
        </div>
    </div>
</div>
<script>
    document.getElementById('TipoDescuento').addEventListener('change', function () {
        let valorInput = document.getElementById('Valor');
        if (this.value === 'Porcentaje') {
            valorInput.placeholder = 'Ej. 15 (para 15% de descuento)';
        } else {
            valorInput.placeholder = 'Ej. 10000 (para $10,000 de descuento)';
        }
    });
</script>