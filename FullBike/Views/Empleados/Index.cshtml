@model IEnumerable<FullBike.Models.Empleado>
@{
    ViewBag.Title = "Empleados - FullBike ERP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section">
    <div class="container">
        <div class="section-title">
            <h2><i class="fas fa-users"></i> Gestión de Empleados</h2>
            <p>Administra el personal y la información laboral</p>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Mensaje"]
            </div>
        }

        <div class="table-container">
            <div class="table-header">
                <h3>Lista de Empleados</h3>
                <div>
                    <a href="@Url.Action("Create", "Empleados")" class="btn">
                        <i class="fas fa-plus"></i> Nuevo Empleado
                    </a>
                    <a href="@Url.Action("Index", "Nomina")" class="btn btn-info">
                        <i class="fas fa-money-bill-wave"></i> Ver Nómina
                    </a>
                    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-back">
                        <i class="fas fa-arrow-left"></i> Volver al Dashboard
                    </a>
                </div>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre Completo</th>
                        <th>Documento</th>
                        <th>Cargo</th>
                        <th>Contrato</th>
                        <th>Estado</th>
                        <th>Salario Base</th>
                        <th>Contacto</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var empleado in Model)
                    {
                        <tr>
                            <td>@empleado.Id</td>
                            <td>
                                <strong>@empleado.NombreCompleto</strong>
                                @if (!string.IsNullOrEmpty(empleado.Direccion))
                                {
                                    <br><small class="text-muted">@empleado.Direccion</small>
                                }
                                @if (!string.IsNullOrEmpty(empleado.Banco))
                                {
                                    <br><small class="text-info">@empleado.Banco - @empleado.NumeroCuenta</small>
                                }
                            </td>
                            <td>@empleado.Documento</td>
                            <td>
                                <span style="background: #e3f2fd; color: #1976d2; padding: 4px 8px; border-radius: 12px; font-size: 12px;">
                                    @empleado.Cargo
                                </span>
                            </td>
                            <td>
                                <span style="background: #e8f5e8; color: #2e7d32; padding: 4px 8px; border-radius: 12px; font-size: 11px;">
                                    @empleado.TipoContrato
                                </span>
                                <br>
                                <small class="text-muted">
                                    Desde: @empleado.FechaContratacion.ToString("dd/MM/yyyy")
                                </small>
                            </td>
                            <td>
                                @{
                                    var estadoColor = empleado.Estado == "Activo" ? "#4caf50" :
                                                    empleado.Estado == "Vacaciones" ? "#ff9800" :
                                                    empleado.Estado == "Incapacitado" ? "#ff5722" :
                                                    "#9e9e9e";
                                    var estadoBg = empleado.Estado == "Activo" ? "#e8f5e8" :
                                                 empleado.Estado == "Vacaciones" ? "#fff3e0" :
                                                 empleado.Estado == "Incapacitado" ? "#ffebee" :
                                                 "#f5f5f5";
                                }
                                <span style="background: @estadoBg; color: @estadoColor; padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold;">
                                    @empleado.Estado
                                </span>
                                @if (!empleado.Activo)
                                {
                                    <br>
                                    <small class="text-danger">
                                        <i class="fas fa-ban"></i> Inactivo
                                    </small>
                                }
                            </td>
                            <td>
                                <strong>$@empleado.SalarioBase.ToString("N0")</strong>
                                <br>
                                <small class="text-muted">
                                    @empleado.MesesTrabajados meses
                                </small>
                            </td>
                            <td>
                                <div>@empleado.Email</div>
                                <div>@empleado.Telefono</div>
                                @if (!string.IsNullOrEmpty(empleado.EPS))
                                {
                                    <small class="text-info">
                                        EPS: @empleado.EPS
                                    </small>
                                }
                            </td>
                            <td class="actions">
                                <div class="action-buttons">
                                    <a href="@Url.Action("Edit", "Empleados", new { id = empleado.Id })" class="btn btn-warning btn-sm" title="Editar empleado">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>

                                    @if (empleado.Activo && empleado.Estado != "Retirado")
                                    {
                                        <a href="@Url.Action("CrearPago", "Nomina", new { empleadoId = empleado.Id })" class="btn btn-info btn-sm" title="Pagar nómina">
                                            <i class="fas fa-money-bill"></i> Pagar
                                        </a>

                                        <a href="@Url.Action("LiquidarContrato", "Nomina", new { empleadoId = empleado.Id })" class="btn btn-danger btn-sm" title="Liquidar contrato">
                                            <i class="fas fa-file-contract"></i> Liquidar
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm" disabled title="Empleado inactivo">
                                            <i class="fas fa-ban"></i> Inactivo
                                        </button>
                                    }

                                    <a href="@Url.Action("Delete", "Empleados", new { id = empleado.Id })" class="btn btn-outline-danger btn-sm" title="Eliminar empleado">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>

                                @if (!string.IsNullOrEmpty(empleado.Usuario))
                                {
                                    <div class="mt-1">
                                        <small class="text-muted">
                                            <i class="fas fa-user"></i> @empleado.Usuario
                                        </small>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<style>
    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .action-buttons .btn-sm {
            padding: 4px 8px;
            font-size: 11px;
            margin: 1px 0;
        }

    .table td {
        vertical-align: middle;
    }

    .actions {
        min-width: 180px;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (localStorage.getItem('isLoggedIn') !== 'true') {
            window.location.href = '@Url.Action("Index", "Home")';
        }
    });
</script>