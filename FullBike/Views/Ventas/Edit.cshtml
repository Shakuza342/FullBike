@model FullBike.Models.Venta
@{
    ViewBag.Title = "Editar Venta #" + Model.Id;
}
<div class="container">
    <div class="page-header">
        <h1><i class="fas fa-edit"></i> Editar Venta #@Model.Id</h1>
        <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Volver</a>
    </div>
    <div class="card">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="form-group">
                    <label>Estado</label>
                    <select name="estado" class="form-control">
                        <option value="Pendiente" @(Model.Estado == "Pendiente" ? "selected" : "")>Pendiente</option>
                        <option value="Completada" @(Model.Estado == "Completada" ? "selected" : "")>Completada</option>
                        <option value="Cancelada" @(Model.Estado == "Cancelada" ? "selected" : "")>Cancelada</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Observaciones</label>
                    <textarea name="observaciones" class="form-control" rows="2">@Model.Observaciones</textarea>
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar cambios</button>
            </form>
        </div>
    </div>
</div>